APP_NAME="Shine Star Marketing"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# --- Production / cPanel: uncomment and fill in on the SERVER's .env ---
# Full walkthrough + asset troubleshooting: docs/DEPLOYMENT.md
# APP_ENV=production
# APP_DEBUG=false                       # must be false in production — true leaks .env/credentials on error pages
# APP_URL=https://yourdomain.com        # EXACT public URL (scheme + domain + subfolder), not localhost
# LOG_LEVEL=error
# QUEUE_CONNECTION=sync                 # shared hosting can't run the queue worker database queues need
# ASSET_URL=https://yourdomain.com/sub  # ONLY if the app is served from a subfolder, and set the SAME
#                                       # value at build time: ASSET_URL=... npm run build (see docs/DEPLOYMENT.md)

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local dev (Laragon/XAMPP)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shine_star_marketing
DB_USERNAME=root
DB_PASSWORD=

# --- Render + Aiven Free MySQL (demo/deploy) ---
# DB_CONNECTION=mysql
# DB_HOST=your-aiven-host.aivencloud.com
# DB_PORT=your-aiven-port
# DB_DATABASE=defaultdb
# DB_USERNAME=avnadmin
# DB_PASSWORD=your-aiven-password
# MYSQL_ATTR_SSL_CA=/path/to/ca.pem

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail: Mailtrap (dev) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@shinestarmarketing.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Mail: Brevo (live/staging) ---
# MAIL_MAILER=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=your-brevo-login
# MAIL_PASSWORD=your-brevo-smtp-key
# MAIL_FROM_ADDRESS="hello@shinestarmarketing.test"
# MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Cloudinary (property/blog images) ---
# Set MEDIA_DISK=cloudinary once CLOUDINARY_URL below is filled in; leave unset to keep storing
# media on the local "public" disk during development.
MEDIA_DISK=public
CLOUDINARY_URL=

# --- Laravel Reverb (real-time chat) ---
# Self-hosted, no external account needed. Values below are auto-generated by `php artisan reverb:install`
# (already run for this project — real values live in .env). Start the server with `php artisan reverb:start`.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

VITE_APP_NAME="${APP_NAME}"
